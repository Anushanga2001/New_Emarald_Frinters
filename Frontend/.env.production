# Used by Vite at BUILD time on Vercel.
# IMPORTANT: After changing values here, you must REDEPLOY on Vercel
# (env vars are baked into the JS bundle at build time).
#
# Same-origin path: requests go to https://<your-vercel-domain>/api/...
# and Vercel rewrites them server-side to http://newemarald.runasp.net/api/...
# (see vercel.json). This avoids browser Mixed Content blocking.
#
# If you also set VITE_API_URL in Vercel -> Settings -> Environment Variables,
# that value overrides this file. Keep them the same.

VITE_API_URL=/api
